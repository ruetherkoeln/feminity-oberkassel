{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bewerten.feminity-oberkassel.de"
        }
      ],
      "destination": "https://www.google.com/maps/search/Feminity+by+Jule+D%C3%BCsseldorf",
      "permanent": true
    },
    {
      "source": "/blog/browlifting.html",
      "destination": "/blog/brow-lamination.html",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/im-salon(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
